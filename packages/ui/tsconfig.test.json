{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom", "react", "react-dom"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "vitest.setup.ts",
    "vitest.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
